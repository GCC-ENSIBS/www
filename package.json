		"clean": "rm -rf dist .astro node_modules"
	},
	"dependencies": {
		"astro": "7.0.3"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.9",
		"@astrojs/ts-plugin": "1.10.9",
		"@biomejs/biome": "2.5.1",
		"typescript": "6.0.3"
	}
