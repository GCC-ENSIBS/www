---
import { localizedPath } from "@/i18n/paths";
import type { Language } from "@/i18n/ui";
import { useTranslations } from "@/i18n/ui";
import Logo from "@/assets/logo.svg";

const { language } = Astro.props as { language: Language };
const translateKey = useTranslations(language);

const homeHref = localizedPath(language, "/");
const base = import.meta.env.BASE_URL;
const pathWithBase = Astro.url.pathname;
const pathWithoutBase = base !== "/" && pathWithBase.startsWith(base) ? pathWithBase.slice(base.length) || "/" : pathWithBase;
const currentPath = pathWithoutBase === "/en" ? "/en/" : pathWithoutBase;
const pathWithoutLanguage = currentPath.startsWith("/en/") ? currentPath.slice(3) || "/" : currentPath;
const englishPath = pathWithoutLanguage === "/" ? "/en/" : `/en${pathWithoutLanguage}`;
const isNotFoundPage = pathWithoutLanguage === "/404" || pathWithoutLanguage === "/404/";

const navigationLinks = [
	{ href: localizedPath(language, "/blog/"), label: translateKey("navigation.blog"), active: pathWithoutLanguage.startsWith("/blog/") },
	{ href: localizedPath(language, "/contact/"), label: translateKey("navigation.contact"), active: pathWithoutLanguage === "/contact/" },
];

const languageLinks = [
	{ href: isNotFoundPage ? localizedPath("fr", "/") : localizedPath("fr", pathWithoutLanguage), label: "FR", active: language === "fr" },
	{ href: isNotFoundPage ? localizedPath("en", "/") : localizedPath("en", pathWithoutLanguage), label: "EN", active: language === "en" },
];
---

<header
	class="sticky top-0 z-40 mx-auto flex w-full max-w-[96rem] items-center gap-5 bg-paper/88 px-4 py-3.5 backdrop-blur-md dark:bg-ink/88 sm:px-6 lg:px-8"
>
	<a
		href={homeHref}
		class="group flex min-h-11 items-center gap-4 text-foreground no-underline transition-opacity duration-200 hover:opacity-90 dark:text-surface"
		aria-label="GCC"
	>
		<Logo width="40" height="40" loading="eager" fetchpriority="high" class="block h-10 w-10" alt="" />
		<span>
			<span class="block font-display text-[18px] font-800 leading-none tracking-[-0.025em] text-foreground dark:text-surface">GCC</span>
			<span class="mt-1 hidden font-sans text-[11px] font-600 leading-none text-foreground-muted dark:text-ink-muted sm:block">{translateKey("navigation.brandSubtitle")}</span>
		</span>
	</a>

	<nav class="hidden gap-7 font-sans text-[14.5px] font-600 md:flex" aria-label={translateKey("navigation.primary")}>
		{
			navigationLinks.map((link) => (
				<a
					href={link.href}
					class:list={[
						"no-underline transition-colors duration-200 hover:text-foreground dark:hover:text-surface",
						link.active ? "text-foreground dark:text-surface" : "text-foreground-muted dark:text-ink-muted",
					]}
					aria-current={link.active ? "page" : undefined}
				>
					{link.label}
				</a>
			))
		}
	</nav>

	<span class="flex-1"></span>

	<div class="hidden md:flex items-center gap-3">
		<div class="inline-flex rounded-sm bg-paper-raised p-0.5 dark:bg-ink-raised">
			{
				languageLinks.map((link) => (
				<a
					href={link.href}
					class="min-h-8 rounded-sm px-2.5 py-1.5 font-sans text-[10.5px] font-600 tracking-[0.04em] no-underline transition-colors duration-200"
						class:list={[
							link.active
								? "bg-foreground text-paper dark:bg-surface dark:text-ink opacity-100"
								: "bg-transparent text-foreground-muted dark:text-ink-muted opacity-100 hover:text-foreground dark:hover:text-surface",
						]}
						aria-current={link.active ? "page" : undefined}
					>
						{link.label}
					</a>
				))
			}
		</div>

		<button
			type="button"
			class="theme-sw flex h-11 w-11 flex-none cursor-pointer items-center justify-center border-0 bg-transparent p-0"
			aria-label={translateKey("theme.toggle")}
			aria-pressed="true"
		>
			<span class="relative h-[23px] w-[42px] rounded-sm bg-paper-raised dark:bg-ink-raised" aria-hidden="true">
				<span class="theme-knob absolute left-[3px] top-[3px] h-[17px] w-[17px] rounded-[4px] bg-foreground dark:bg-surface"></span>
			</span>
		</button>
	</div>

	<button
		id="nav-menu-button"
		type="button"
		class="flex h-11 w-11 items-center justify-center rounded-sm border border-border text-foreground-muted transition-colors duration-200 hover:border-brand-deep hover:text-brand-deep dark:text-ink-muted dark:hover:border-brand-bright dark:hover:text-brand-bright md:hidden"
		aria-label={translateKey("menu.open")}
		aria-expanded="false"
		aria-controls="nav-menu-panel"
		data-open-label={translateKey("menu.open")}
		data-close-label={translateKey("menu.close")}
	>
		<span class="i-lucide-menu block size-5" aria-hidden="true"></span>
	</button>
</header>

<div
	id="nav-menu-panel"
	class="sticky z-39 hidden border-b border-border bg-paper/96 backdrop-blur-md dark:bg-ink/96 md:hidden"
	style="top: var(--header-h, 0px);"
>
	<ul class="mx-auto flex max-w-[67.5rem] flex-col px-4 py-3 sm:px-6 lg:px-14">
		{
			navigationLinks.map((link) => (
				<li class="border-b border-border last:border-b-0">
					<a
						href={link.href}
						class:list={[
							"block py-3 font-sans text-sm font-600 transition-opacity duration-200 hover:opacity-100",
							link.active ? "text-foreground opacity-100 dark:text-surface" : "text-foreground-muted opacity-100 dark:text-ink-muted",
						]}
						aria-current={link.active ? "page" : undefined}
					>
						{link.label}
					</a>
				</li>
			))
		}
		<li class="flex items-center gap-4 py-3">
			<div class="inline-flex rounded-sm bg-paper-raised p-0.5 dark:bg-ink-raised">
				{
					languageLinks.map((link) => (
						<a
							href={link.href}
							class="min-h-8 rounded-sm px-2.5 py-1.5 font-sans text-[10.5px] font-600 tracking-[0.04em] no-underline transition-colors duration-200"
							class:list={[
								link.active
									? "bg-foreground text-paper dark:bg-surface dark:text-ink opacity-100"
									: "bg-transparent text-foreground-muted dark:text-ink-muted opacity-100 hover:text-foreground dark:hover:text-surface",
							]}
							aria-current={link.active ? "page" : undefined}
						>
							{link.label}
						</a>
					))
				}
			</div>
			<button
				type="button"
				class="theme-sw flex h-11 w-11 flex-none cursor-pointer items-center justify-center border-0 bg-transparent p-0"
				aria-label={translateKey("theme.toggle")}
				aria-pressed="true"
			>
				<span class="relative h-[23px] w-[42px] rounded-sm bg-paper-raised dark:bg-ink-raised" aria-hidden="true">
					<span class="theme-knob absolute left-[3px] top-[3px] h-[17px] w-[17px] rounded-[4px] bg-foreground dark:bg-surface"></span>
				</span>
			</button>
		</li>
	</ul>
</div>

<style is:global>
	.theme-knob {
		transition: transform 0.26s ease, background 0.26s;
	}
	html.dark .theme-knob {
		transform: translateX(19px);
	}
</style>

<script>
	// ---- Header height measurement ----
	const measureHeader = () => {
		const header = document.querySelector("header");
		if (header) {
			document.documentElement.style.setProperty("--header-h", `${header.offsetHeight}px`);
		}
	};
	measureHeader();
	window.addEventListener("resize", measureHeader);

	// ---- Mobile menu ----
	const button = document.getElementById("nav-menu-button");
	const panel = document.getElementById("nav-menu-panel");
	const setMenuOpen = (open: boolean) => {
		panel?.classList.toggle("hidden", !open);
		button?.setAttribute("aria-expanded", String(open));
		button?.setAttribute("aria-label", open ? button.dataset.closeLabel ?? "" : button.dataset.openLabel ?? "");

		const icon = button?.querySelector("span");
		if (icon) {
			icon.classList.toggle("i-lucide-menu", !open);
			icon.classList.toggle("i-lucide-x", open);
		}
	};

	button?.addEventListener("click", () => {
		setMenuOpen(panel?.classList.contains("hidden") ?? true);
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && !panel?.classList.contains("hidden")) {
			setMenuOpen(false);
			button?.focus();
		}
	});

	// ---- Theme toggle ----
	const isDarkTheme = () => document.documentElement.classList.contains("dark");

	const syncToggle = (isDark: boolean) => {
		try {
			localStorage.setItem("theme", isDark ? "dark" : "light");
		} catch (_) {}
	};

	const toggleTheme = () => {
		const isDark = document.documentElement.classList.toggle("dark");
		syncToggle(isDark);
		document.querySelectorAll(".theme-sw").forEach((toggle) => {
			toggle.setAttribute("aria-pressed", String(isDark));
		});
		const themeColorMeta = document.getElementById("theme-color-meta");
		if (themeColorMeta) {
			themeColorMeta.setAttribute("content", isDark ? "#191923" : "#f4f4f6");
		}
	};

	document.querySelectorAll(".theme-sw").forEach((el) => {
		el.setAttribute("aria-pressed", String(isDarkTheme()));
		el.addEventListener("click", toggleTheme);
	});
</script>
