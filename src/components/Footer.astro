---
import Logo from "@/assets/logo.svg";
import { socials } from "@/data/socials";
import { localizedPath } from "@/i18n/paths";
import type { Language } from "@/i18n/ui";
import { useTranslations } from "@/i18n/ui";

const { language } = Astro.props as { language: Language };
const translateKey = useTranslations(language);
const year = new Date().getFullYear();

const links = [
	{ label: "Discord", href: socials.discord },
	{ label: "YouTube", href: socials.youtube },
	{ label: "LinkedIn", href: socials.linkedin },
	{ label: "X", href: socials.x },
];
---

<footer class="border-t border-border/70 bg-paper/90 px-4 py-5 text-foreground backdrop-blur dark:border-surface/18 dark:bg-ink/90 dark:text-ink-muted sm:px-6 lg:px-8">
	<div class="mx-auto flex w-full max-w-[96rem] flex-col gap-5 md:flex-row md:items-end md:justify-between">
		<div class="flex items-center gap-4">
			<a href={localizedPath(language, "/")} class="flex min-h-11 min-w-11 shrink-0 items-center text-foreground no-underline dark:text-surface">
				<Logo alt="GCC" width="42" height="42" loading="lazy" class="h-[42px] w-auto" />
			</a>
			<div>
				<p class="max-w-[48ch] font-sans text-sm font-500 leading-[1.65] text-foreground-muted dark:text-ink-muted">
					{translateKey("footer.description")}
				</p>
				<p class="mt-3 font-sans text-xs font-600 text-foreground-subtle dark:text-ink-subtle">
					{translateKey("footer.colophon")} · © {year}
				</p>
			</div>
		</div>

		<nav class="grid w-full max-w-[15rem] grid-cols-2 gap-2 font-sans text-sm font-700 md:w-[15rem]" aria-label={translateKey("navigation.footer")}>
			{links.map((link) => (
				<a href={link.href} class="flex min-h-11 items-center justify-center rounded-sm bg-paper-raised px-3 py-2 text-center text-foreground no-underline transition-colors hover:text-brand-deep dark:bg-ink-raised dark:text-surface dark:hover:text-brand-bright" target="_blank" rel="noopener me">
					{link.label}<span class="sr-only"> ({translateKey("navigation.external")})</span>
				</a>
			))}
		</nav>
	</div>
</footer>
