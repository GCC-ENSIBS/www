{
	"$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/*.md",
			"!**/*.yaml",
			"!**/*.yml",
			"!**/*.svg",
			"!**/pnpm-lock.yaml"
		]
	},
	"html": {
		"experimentalFullSupportEnabled": true
	}
}
